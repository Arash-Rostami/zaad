GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Private admin gate for /ledger (the inquiry-message register). Any long random
# string; the sha256 fingerprint is stored in an httpOnly cookie on unlock.
ZAAD_LEDGER_KEY="MY_LEDGER_KEY"

# Optional: only needed to route the curator through a gateway/proxy instead
# of the native Google Gemini API. Leave both unset to use GEMINI_API_KEY
# above with the default model.
GEMINI_MODEL="Gemini-3.1-Flash-Lite"
GEMINI_BASE_URL=""
GEMINI_GATEWAY_API_KEY=""
